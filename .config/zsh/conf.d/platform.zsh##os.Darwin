# Configure Homebrew on both Apple Silicon and Intel Macs. `brew shellenv`
# emits nothing when the current environment is already configured and also
# adds Homebrew's zsh completions to the function path.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv zsh)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv zsh)"
fi

# Prefer GNU ls when coreutils is installed, with the native macOS color mode
# as a fallback.
if (( $+commands[gls] )); then
  alias ls="gls --color=auto --human-readable"
else
  alias ls="ls -G"
fi
